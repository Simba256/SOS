rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to validate data size
    function isValidSize(size) {
      return request.resource.size() < size;
    }

    // ============================================
    // USER PROFILES
    // ============================================
    match /users/{userId} {
      // Users can read and write their own profile only
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSize(100 * 1024); // 100KB limit
      allow update: if isOwner(userId) && isValidSize(100 * 1024);
      allow delete: if isOwner(userId);

      // Emergency contacts subcollection
      match /emergency_contacts/{contactId} {
        // Users can only access their own emergency contacts
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSize(10 * 1024); // 10KB per contact
        allow delete: if isOwner(userId);
      }

      // User settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // SOS ALERTS
    // ============================================
    match /sos_alerts/{alertId} {
      // Anyone authenticated can create an alert
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidSize(50 * 1024); // 50KB limit per alert

      // Users can read their own alerts and alerts where they are an emergency contact
      allow read: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid ||
                     request.auth.uid in resource.data.emergencyContactIds);

      // Users can update their own alerts (e.g., to mark as resolved)
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      isValidSize(50 * 1024);

      // Users can delete their own alerts
      allow delete: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
    }

    // ============================================
    // EMERGENCY CONTACTS (if stored at root level)
    // ============================================
    match /emergency_contacts/{contactId} {
      // Users can only access contacts they created
      allow read, write: if isAuthenticated() &&
                           resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidSize(10 * 1024);
    }

    // ============================================
    // LOCATION SHARING
    // ============================================
    match /shared_locations/{locationId} {
      // Users can create location shares
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidSize(5 * 1024);

      // Users can read their own shared locations and locations shared with them
      allow read: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid ||
                     request.auth.uid in resource.data.sharedWith);

      // Users can update/delete their own location shares
      allow update, delete: if isAuthenticated() &&
                              resource.data.userId == request.auth.uid;
    }

    // ============================================
    // DENY ALL OTHER ACCESS
    // ============================================
    // Any path not explicitly allowed above will be denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
